server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    location / { try_files $uri $uri/ =404; add_header Cache-Control "no-cache"; }
    location /assets/ { try_files $uri =404; add_header Cache-Control "public, max-age=3600"; }
    location = /health { access_log off; default_type text/plain; return 200 'ok'; }
}
